OPENAI_API_KEY=your_openai_api_key_here
COHERE_API_KEY=your_cohere_api_key_here   # needed by the Rerank pipeline only

# LLM port: which adapter to use (openai | fake)
LLM_PROVIDER=openai
# Exact API model ID for the generator ("Sol"). Required when LLM_PROVIDER=openai.
LLM_MODEL=
# Optional: override the reasoning levels offered in the UI, e.g. "low,medium,high",
# or "unsupported" to disable the selector. Leave blank to use the adapter's defaults.
LLM_REASONING_EFFORTS=
DEFAULT_REASONING_EFFORT=medium

EMBEDDING_MODEL=text-embedding-3-small
DATA_DIR=../data
INDEX_DIR=.index
DATASETS_DIR=.datasets     # saved test sets; git-ignored
EVALS_DIR=.evals           # saved evaluation runs; git-ignored

# Test set generation (SDG). See README "Choosing models for SDG and judging".
SDG_PROVIDER=ragas                          # ragas | fake (offline, deterministic)
SDG_LLM_MODEL=gpt-4.1                       # builds the knowledge graph and writes the questions
SDG_EMBEDDING_MODEL=text-embedding-3-small
SDG_REASONING_EFFORT=                       # only if SDG_LLM_MODEL is a reasoning model; use low
SDG_PRICE_INPUT_PER_MTOK=                   # optional: USD per 1M input tokens for SDG_LLM_MODEL
SDG_PRICE_OUTPUT_PER_MTOK=                  # optional: USD per 1M output tokens; both needed to show a cost

# Optional LangSmith tracing
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=rag-chatbot
